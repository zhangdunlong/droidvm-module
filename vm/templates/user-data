#cloud-config
# DroidVM 首启自动装配：SSH / Docker / 1Panel
# 本文件为模块模板，安装时由 customize.sh 读取 settings.conf 生成最终 seed.iso
hostname: droidvm
fqdn: droidvm.local
manage_etc_hosts: false
locale: en_US.UTF-8
timezone: Asia/Shanghai

users:
  - name: dvm
    gecos: DroidVM Admin
    groups: [sudo, adm]
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: '__DVM_PASSWORD__'
    sudo: ALL=(ALL) NOPASSWD:ALL

chpasswd:
  expire: false
  list: |
    root:__DVM_PASSWORD__

ssh_pwauth: true
disable_root: false

write_files:
  - path: /etc/ssh/sshd_config.d/99-dvm.conf
    permissions: '0644'
    content: |
      PasswordAuthentication yes
      PermitRootLogin yes
      KbdInteractiveAuthentication yes

  # 客户机 DNS 指向公共解析，避免依赖手机侧解析链路
  - path: /etc/resolv.conf
    permissions: '0644'
    content: |
      nameserver 223.5.5.5
      nameserver 119.29.29.29

  - path: /etc/hosts
    permissions: '0644'
    content: |
      127.0.0.1       localhost droidvm
      ::1             localhost ip6-local-localhost ip6-localhost
      101.6.15.130    mirrors.tuna.tsinghua.edu.cn
      151.101.90.132  deb.debian.org security.debian.org
      122.193.131.46  resource.fit2cloud.com

  - path: /etc/apt/sources.list.d/debian.sources
    permissions: '0644'
    content: |
      Types: deb
      URIs: http://mirrors.tuna.tsinghua.edu.cn/debian
      Suites: bookworm bookworm-updates
      Components: main contrib non-free non-free-firmware
      Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

      Types: deb
      URIs: http://mirrors.tuna.tsinghua.edu.cn/debian-security
      Suites: bookworm-security
      Components: main contrib non-free non-free-firmware
      Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

  - path: /etc/docker/daemon.json
    permissions: '0644'
    content: |
      {
        "registry-mirrors": [
          "https://docker.m.daocloud.io",
          "https://mirror.ccs.tencentyun.com"
        ],
        "log-driver": "json-file",
        "log-opts": { "max-size": "10m", "max-file": "3" }
      }

  - path: /usr/local/sbin/dvm-setup.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      exec > /var/log/dvm-setup.log 2>&1
      set -x
      export DEBIAN_FRONTEND=noninteractive

      echo "=== [1/4] 基础环境 ==="
      apt-get update -y
      apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg sudo openssh-server \
        vim htop net-tools iproute2 systemd-timesyncd
      systemctl enable --now ssh
      systemctl enable --now systemd-timesyncd || true

      echo "=== [2/4] 安装 Docker CE（清华镜像源）==="
      install -m 0755 -d /etc/apt/keyrings
      curl -fsSL https://mirrors.tuna.tsinghua.edu.cn/docker-ce/linux/debian/gpg \
        | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
      chmod a+r /etc/apt/keyrings/docker.gpg
      echo "deb [arch=arm64 signed-by=/etc/apt/keyrings/docker.gpg] https://mirrors.tuna.tsinghua.edu.cn/docker-ce/linux/debian bookworm stable" \
        > /etc/apt/sources.list.d/docker.list
      apt-get update -y
      apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
      systemctl enable --now docker
      sleep 3
      docker version || true
      echo "DOCKER_VERIFY_BEGIN"
      docker run --rm hello-world || true
      echo "DOCKER_VERIFY_END"

      echo "=== [3/4] 安装 1Panel v2（非交互）==="
      cd /opt
      curl -fsSL https://resource.fit2cloud.com/1panel/package/v2/quick_start.sh -o quick_start.sh
      bash quick_start.sh --non-interactive --lang zh --install-dir /opt \
        --port __PANEL_PORT__ --entrance __PANEL_ENTRANCE__ --username __PANEL_USER__ \
        --password '__PANEL_PASSWORD__' --install-docker n --docker-mode online

      echo "=== [4/4] 汇总 ==="
      ss -tlun | grep -E ':(22|__PANEL_PORT__)\b' || true
      echo "DVMSETUP_DONE"

runcmd:
  - [ bash, /usr/local/sbin/dvm-setup.sh ]
  - [ sh, -c, "touch /var/lib/dvm-setup-finished" ]
